FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

APP_PORT=5000

# Generate SECRET_KEY and JWT_SECRET_KEY separately with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SECRET_KEY=

# Use a strong, unique password that satisfies the authentication requirements.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
CLIENT_SEED_EMAIL=client@example.com
CLIENT_SEED_PASSWORD=
CLIENT_SEED_FIRST_NAME=Client
CLIENT_SEED_LAST_NAME=User

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pet_ecommerce_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

REDIS_ENABLED=false
REDIS_HOST=your-redis-cloud-host
REDIS_PORT=your-redis-cloud-port
REDIS_DB=0
REDIS_PASSWORD=your-redis-cloud-password
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_KEY_PREFIX=pet_ecommerce
REDIS_SSL=false
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
