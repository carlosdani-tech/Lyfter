# Configuration template only; not a runnable credential configuration.
# Supply secrets privately. Never commit the real .env or expanded database URI.
# Start commands select the Flask app, development debug mode, and port explicitly.
# APP_PORT and FLASK_ENV are not application configuration settings.
# Use independently generated signing keys; leave no real secret in this file.
SECRET_KEY=
JWT_SECRET_KEY=

# Use a strong, unique password that satisfies the authentication requirements.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
CLIENT_SEED_EMAIL=
CLIENT_SEED_PASSWORD=
CLIENT_SEED_FIRST_NAME=Client
CLIENT_SEED_LAST_NAME=User

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pet_ecommerce_db
DATABASE_USER=
DATABASE_PASSWORD=

REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=0
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_KEY_PREFIX=pet_ecommerce
REDIS_SSL=false
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

# Email is opt-in. Keep disabled until the sender and SMTP service are verified.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# Explicit encrypted mode: starttls (usually 587) or ssl (usually 465).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Bare address only; no display name or recipient lists.
SMTP_SENDER=
# Finite timeout for socket connection and subsequent blocking reads/writes (1-60 seconds).
SMTP_TIMEOUT_SECONDS=10
